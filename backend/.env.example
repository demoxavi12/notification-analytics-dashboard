PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/notification_dashboard
# Optional response cache. redis:// or rediss:// (TLS); credentials go in the URL and
# are never logged. Without Redis the API caches in process memory. Development
# defaults to redis://localhost:6379; production uses Redis only when this is set.
REDIS_URL=redis://localhost:6379
# Required. At least 32 random characters; the server refuses to start in production
# without a strong value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=100
# Number of reverse proxies in front of the API (e.g. 1 behind a load balancer) so
# rate limits see the real client IP. Leave unset when clients connect directly.
# TRUST_PROXY=1
