# Backend API base URL (public, baked into the build; never put secrets in VITE_ vars).
# If unset: development uses http://localhost:5000/api, production builds use /api
# on the same origin (e.g. behind a reverse proxy).
VITE_API_URL=http://localhost:5000/api

# Show the one-click Admin/User demo login buttons in production builds.
# They are always shown in `npm run dev`. Leave unset for real deployments.
# VITE_ENABLE_DEMO_LOGIN=true
